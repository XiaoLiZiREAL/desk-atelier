<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="MenuPaper" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Hairline" Color="#D8DFE7" />
  <SolidColorBrush x:Key="Ink" Color="#182433" />
  <SolidColorBrush x:Key="Hover" Color="#EDEFF2" />

  <Style x:Key="MenuSurface" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource MenuPaper}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="MinWidth" Value="164" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Style="{StaticResource MenuSurface}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="Entry" TargetType="MenuItem">
    <Grid>
      <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="10,0,8,0">
        <Grid Height="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <ContentPresenter Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
          <Border x:Name="Switch" Grid.Column="3" Width="28" Height="16" Margin="12,0,1,0"
                  Visibility="Collapsed" VerticalAlignment="Center" CornerRadius="8"
                  Background="#F5F6F8" BorderBrush="#778390" BorderThickness="1" Padding="2">
            <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="#64717E" HorizontalAlignment="Left" />
          </Border>
        </Grid>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsCheckable" Value="True">
        <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Switch" Property="Background" Value="#386DAD" />
        <Setter TargetName="Switch" Property="BorderBrush" Value="#386DAD" />
        <Setter TargetName="Thumb" Property="Fill" Value="White" />
        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Row" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Template" Value="{StaticResource Entry}" />
  </Style>
  <Style x:Key="MenuDivider" TargetType="Separator">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="#E2E5E8" Margin="7,4" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
